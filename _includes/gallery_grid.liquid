{% assign photos = include.photos %}
{% assign lightbox_group = include.lightbox_group | default: 'gallery' %}

{% if photos and photos.size > 0 %}
  <style>
    .gallery-photo-list {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: flex-start;
    }
    .gallery-photo-list figure {
      margin: 0;
    }
    .gallery-photo-list img {
      height: 320px !important;
      width: auto !important;
      max-width: 100%;
      display: block;
      object-fit: contain;
    }
    .gallery-photo-list .caption {
      margin-top: 0.35rem;
      font-size: 0.875rem;
      color: var(--global-text-color-light, #6c757d);
    }
  </style>
  <div class="gallery-photo-list">
    {% for photo in photos %}
      {% if photo.path %}
        {% assign alt_text = photo.caption | default: 'Gallery image' %}
        {% assign photo_url = photo.path | relative_url %}
        <div>
          <a href="{{ photo_url }}" data-lightbox="{{ lightbox_group }}" data-title="{{ alt_text }}">
            {%
              include figure.liquid
              path=photo.path
              caption=photo.caption
              sizes='320px'
              alt=alt_text
            %}
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted">이 앨범에 아직 사진이 없습니다. <code>_data/gallery.yml</code>에 사진을 추가하세요.</p>
{% endif %}
