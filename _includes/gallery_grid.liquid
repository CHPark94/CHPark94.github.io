{% assign photos = include.photos %}
{% assign lightbox_group = include.lightbox_group | default: 'gallery' %}

{% if photos and photos.size > 0 %}
  <style>
    .gallery-photo-thumb {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      position: relative;
      background: var(--global-bg-color, #f5f5f5);
    }
    .gallery-photo-thumb figure,
    .gallery-photo-thumb picture {
      position: absolute;
      inset: 0;
      margin: 0;
      width: 100%;
      height: 100%;
    }
    .gallery-photo-thumb img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .gallery-photo-card .card-body {
      min-height: 2.5rem;
    }
  </style>
  <div class="grid">
    {% for photo in photos %}
      {% if photo.path %}
        {% assign alt_text = photo.caption | default: 'Gallery image' %}
        {% assign photo_url = photo.path | relative_url %}
        <div class="grid-item">
          <div class="card hoverable gallery-photo-card">
            <a href="{{ photo_url }}" data-lightbox="{{ lightbox_group }}" data-title="{{ alt_text }}">
              <div class="gallery-photo-thumb">
                {%
                  include figure.liquid
                  path=photo.path
                  sizes='(min-width: 768px) 250px, 90vw'
                  class='card-img-top'
                  alt=alt_text
                %}
              </div>
              {% if photo.caption %}
                <div class="card-body p-2">
                  <p class="card-text small text-muted mb-0">{{ photo.caption }}</p>
                </div>
              {% endif %}
            </a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted">이 앨범에 아직 사진이 없습니다. <code>_data/gallery.yml</code>에 사진을 추가하세요.</p>
{% endif %}
