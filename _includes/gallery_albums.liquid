{% if site.data.gallery.albums and site.data.gallery.albums.size > 0 %}
  <style>
    .gallery-album-cover {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      position: relative;
      background: var(--global-bg-color, #f5f5f5);
    }
    .gallery-album-cover figure,
    .gallery-album-cover picture {
      position: absolute;
      inset: 0;
      margin: 0;
      width: 100%;
      height: 100%;
    }
    .gallery-album-cover img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .gallery-album-card .card-body {
      min-height: 4.5rem;
    }
    .gallery-year {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      margin: 0.25rem 0 0.75rem;
    }
  </style>
  {% if site.data.gallery.groups and site.data.gallery.groups.size > 0 %}
    {% for group in site.data.gallery.groups %}
      {% assign group_count = 0 %}
      {% for album in site.data.gallery.albums %}
        {% if album.group == group.id and album.id and album.cover %}
          {% assign group_count = group_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if group_count > 0 %}
        <h2 class="mt-4">{{ group.title }}</h2>
        {% assign rows = site.data.gallery.albums | where: 'group', group.id | sort: 'date' | reverse %}
        {% include gallery_album_year_rows.liquid %}
      {% endif %}
    {% endfor %}
  {% else %}
    <h2 class="mt-4">Albums</h2>
    {% assign rows = site.data.gallery.albums | sort: 'date' | reverse %}
    {% include gallery_album_year_rows.liquid %}
  {% endif %}
{% else %}
  <p class="text-muted">앨범을 추가하려면 <code>_data/gallery.yml</code>을 수정하세요.</p>
{% endif %}
