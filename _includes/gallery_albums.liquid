{% if site.data.gallery.albums and site.data.gallery.albums.size > 0 %}
  <style>
    .gallery-album-cover {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      position: relative;
      background: var(--global-bg-color, #f5f5f5);
    }
    .gallery-album-cover figure,
    .gallery-album-cover picture {
      position: absolute;
      inset: 0;
      margin: 0;
      width: 100%;
      height: 100%;
    }
    .gallery-album-cover img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .gallery-album-card .card-body {
      min-height: 4.5rem;
    }
  </style>
  <div class="row">
    {% for album in site.data.gallery.albums %}
      {% if album.id and album.cover %}
        {% assign album_url = album.id | prepend: '/gallery/' | append: '/' %}
        {% assign alt_text = album.title | default: 'Album cover' %}
        <div class="col-6 col-md-4 mb-4">
          <a href="{{ album_url | relative_url }}" class="text-decoration-none text-reset">
            <div class="card hoverable h-100 gallery-album-card">
              <div class="gallery-album-cover">
                {%
                  include figure.liquid
                  path=album.cover
                  sizes='(min-width: 768px) 250px, 45vw'
                  class='card-img-top'
                  alt=alt_text
                %}
              </div>
              <div class="card-body p-2">
                <h3 class="card-title h5 mb-1">{{ album.title }}</h3>
                {% if album.description %}
                  <p class="card-text small text-muted mb-0">{{ album.description }}</p>
                {% endif %}
              </div>
            </div>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  <p class="text-muted">앨범을 추가하려면 <code>_data/gallery.yml</code>을 수정하세요.</p>
{% endif %}
